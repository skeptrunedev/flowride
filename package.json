{
  "name": "flow-ride",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "description": "Scenic motorcycle navigation with automatic pass-through points and rerouting that preserves the ride.",
  "license": "MIT",
  "author": "skeptrunedev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skeptrunedev/flowride.git"
  },
  "homepage": "https://ride.skeptrune.com",
  "bugs": {
    "url": "https://github.com/skeptrunedev/flowride/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "motorcycle",
    "navigation",
    "scenic-routes",
    "react",
    "vite",
    "leaflet",
    "osrm"
  ]
}
